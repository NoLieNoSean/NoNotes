@article{KakeyaSet2025,
  title = {Kakeya Set},
  year = 2025,
  month = jun,
  journal = {Wikipedia},
  url = {https://en.wikipedia.org/w/index.php?title=Kakeya_set&oldid=1294931373#cite_note-3},
  urldate = {2025-06-17},
  abstract = {In mathematics, a Kakeya set, or Besicovitch set, is a set of points in Euclidean space which contains a unit line segment in every direction. For instance, a disk of radius 1/2 in the Euclidean plane, or a ball of radius 1/2 in three-dimensional space, forms a Kakeya set. Much of the research in this area has studied the problem of how small such sets can be. Besicovitch showed that there are Besicovitch sets of measure zero. A Kakeya needle set (sometimes also known as a Kakeya set) is a (Besicovitch) set in the plane with a stronger property, that a unit line segment can be rotated continuously through 180 degrees within it, returning to its original position with reversed orientation. Again, the disk of radius 1/2 is an example of a Kakeya needle set.},
  copyright = {Creative Commons Attribution-ShareAlike License},
  langid = {english},
  annotation = {Page Version ID: 1294931373}
}

@misc{karaMultiReesAlgebrasStrongly2022,
  title = {Multi-{{Rees Algebras}} of {{Strongly Stable Ideals}}},
  author = {Kara, Selvi and Lin, Kuei-Nuan and Sosa, Gabriel},
  year = 2022,
  month = nov,
  number = {arXiv:2012.15447},
  eprint = {2012.15447},
  primaryclass = {math},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2012.15447},
  url = {http://arxiv.org/abs/2012.15447},
  urldate = {2025-09-02},
  abstract = {We prove that the multi-Rees algebra R(I1 {$\oplus$} {$\cdot$} {$\cdot$} {$\cdot$} {$\oplus$} Ir) of a collection of strongly stable ideals I1, . . . , Ir is of fiber type. In particular, we provide a Gr\textasciidieresis obner basis for its defining ideal as a union of a Gr\textasciidieresis obner basis for its special fiber and binomial syzygies. We also study the Koszulness of R(I1 {$\oplus$} {$\cdot$} {$\cdot$} {$\cdot$} {$\oplus$} Ir) based on parameters associated to the collection. Furthermore, we establish a quadratic Gr\textasciidieresis obner basis of the defining ideal of R(I1 {$\oplus$} I2) where each of the strongly stable ideals has two quadric Borel generators. As a consequence, we conclude that this multi-Rees algebra is Koszul.},
