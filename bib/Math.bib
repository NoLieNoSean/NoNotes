@misc{taoAlmostAllOrbits2022,
  title = {Almost All Orbits of the {{Collatz}} Map Attain Almost Bounded Values},
  author = {Tao, Terence},
  year = 2022,
  month = feb,
  number = {arXiv:1909.03562},
  eprint = {1909.03562},
  primaryclass = {math},
  publisher = {arXiv},
  doi = {10.48550/arXiv.1909.03562},
  url = {http://arxiv.org/abs/1909.03562},
  urldate = {2026-04-25},
  abstract = {Define the \textbackslash emph\textbraceleft Collatz map\textbraceright{} \$\textbackslash mathrm\textbraceleft Col\textbraceright{} : \textbackslash mathbb\textbraceleft N\textbraceright +1 \textbackslash to \textbackslash mathbb\textbraceleft N\textbraceright +1\$ on the positive integers \$\textbackslash mathbb\textbraceleft N\textbraceright +1 = \textbackslash\textbraceleft 1,2,3,\textbackslash dots\textbackslash\textbraceright\$ by setting \$\textbackslash mathrm\textbraceleft Col\textbraceright (N)\$ equal to \$3N+1\$ when \$N\$ is odd and \$N/2\$ when \$N\$ is even, and let \$\textbackslash mathrm\textbraceleft Col\textbraceright\_\textbraceleft\textbackslash min\textbraceright (N) := \textbackslash inf\_\textbraceleft n \textbackslash in \textbackslash mathbb\textbraceleft N\textbraceright\textbraceright{} \textbackslash mathrm\textbraceleft Col\textbraceright\textasciicircum n(N)\$ denote the minimal element of the Collatz orbit \$N, \textbackslash mathrm\textbraceleft Col\textbraceright (N), \textbackslash mathrm\textbraceleft Col\textbraceright\textasciicircum 2(N), \textbackslash dots\$. The infamous \textbackslash emph\textbraceleft Collatz conjecture\textbraceright{} asserts that \$\textbackslash mathrm\textbraceleft Col\textbraceright\_\textbraceleft\textbackslash min\textbraceright (N)=1\$ for all \$N \textbackslash in \textbackslash mathbb\textbraceleft N\textbraceright +1\$. Previously, it was shown by Korec that for any \$\texttheta{$>$} \textbackslash frac\textbraceleft\textbackslash log 3\textbraceright\textbraceleft\textbackslash log 4\textbraceright{} \textbackslash approx 0.7924\$, one has \$\textbackslash mathrm\textbraceleft Col\textbraceright\_\textbraceleft\textbackslash min\textbraceright (N) \textbackslash leq N\textasciicircum\texttheta\$ for almost all \$N \textbackslash in \textbackslash mathbb\textbraceleft N\textbraceright +1\$ (in the sense of natural density). In this paper we show that for \textbackslash emph\textbraceleft any\textbraceright{} function \$f : \textbackslash mathbb\textbraceleft N\textbraceright +1 \textbackslash to \textbackslash mathbb\textbraceleft R\textbraceright\$ with \$\textbackslash lim\_\textbraceleft N \textbackslash to \textbackslash infty\textbraceright{} f(N)=+\textbackslash infty\$, one has \$\textbackslash mathrm\textbraceleft Col\textbraceright\_\textbraceleft\textbackslash min\textbraceright (N) \textbackslash leq f(N)\$ for almost all \$N \textbackslash in \textbackslash mathbb\textbraceleft N\textbraceright +1\$ (in the sense of logarithmic density). Our proof proceeds by establishing an approximate transport property for a certain first passage random variable associated with the Collatz iteration (or more precisely, the closely related Syracuse iteration), which in turn follows from estimation of the characteristic function of a certain skew random walk on a \$3\$-adic cyclic group at high frequencies. This estimation is achieved by studying how a certain two-dimensional renewal process interacts with a union of triangles associated to a given frequency.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {Mathematics - Dynamical Systems,Mathematics - Number Theory,Mathematics - Probability}
}

