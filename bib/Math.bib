@article{AssociatedPrime2025,
  title = {Associated Prime},
  year = 2025,
  month = mar,
  journal = {Wikipedia},
  url = {https://en.wikipedia.org/w/index.php?title=Associated_prime&oldid=1278984891#CITEREFLam1999},
  urldate = {2026-01-09},
  abstract = {In abstract algebra, an associated prime of a module M over a ring R is a type of prime ideal of R that arises as an annihilator of a (prime) submodule of M.  The set of associated primes is usually denoted by                                    Ass                        R                             ⁡         (         M         )         ,                 \textbraceleft\textbackslash displaystyle \textbackslash operatorname \textbraceleft Ass\textbraceright{} \_\textbraceleft R\textbraceright (M),\textbraceright{}     and sometimes called the assassin or assassinator of M (word play between the notation and the fact that an  associated prime is an annihilator). In commutative algebra, associated primes are linked to the Lasker--Noether primary decomposition of ideals in commutative Noetherian rings. Specifically, if an ideal J is decomposed as a finite intersection of primary ideals, the radicals of these primary ideals are prime ideals, and this set of prime ideals coincides with                                    Ass                        R                             ⁡         (         R                    /                  J         )         .                 \textbraceleft\textbackslash displaystyle \textbackslash operatorname \textbraceleft Ass\textbraceright{} \_\textbraceleft R\textbraceright (R/J).\textbraceright{}     Also linked with the concept of "associated primes" of the ideal are the notions of isolated primes and embedded primes.},
  copyright = {Creative Commons Attribution-ShareAlike License},
  langid = {english},
  annotation = {Page Version ID: 1278984891}
}

