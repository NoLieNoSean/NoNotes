@misc{biswasLatticePointsArising2026,
  title = {Lattice Points Arising from Regularity and \$\textbackslash mathrm\textbraceleft v\textbraceright\$-Number of {{Graphs}}: {{Whisker}} and {{Cameron-Walker}}},
  shorttitle = {Lattice Points Arising from Regularity and \$\textbackslash mathrm\textbraceleft v\textbraceright\$-Number of {{Graphs}}},
  author = {Biswas, Prativa and Mandal, Mousumi and Saha, Kamalesh},
  year = 2026,
  month = mar,
  number = {arXiv:2603.04876},
  eprint = {2603.04876},
  primaryclass = {math},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2603.04876},
  url = {http://arxiv.org/abs/2603.04876},
  urldate = {2026-03-07},
  abstract = {Let G be a simple graph on n vertices and I(G) {$\subseteq$} R be its edge ideal. In this paper, we initiate the study of determining lattice points in N2 that appear as a pair (reg(R/I(G)), v(I(G))), where G ranges over all connected graphs on n vertices, and we denote this set by RV(n). Here `reg' denotes the (Castelnuovo-Mumford) regularity and `v' denotes the v-number. We establish general bounds for RV(n) by identifying two sets A(n) and B(n) satisfying A(n) {$\subseteq$} RV(n) {$\subseteq$} B(n). Furthermore, we explicitly determine the subsets of RV(n) consisting of all possible pairs (reg(R/I(G)), v(I(G))) arising from whisker graphs and Cameron-Walker graphs on n vertices. Finally, we propose a conjecture on the subset of RV(n) arising from connected chordal graphs.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {Mathematics - Combinatorics,Mathematics - Commutative Algebra}
}

