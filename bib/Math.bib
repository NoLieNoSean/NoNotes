@article{OpenMappingTheorem2026,
  title = {Open Mapping Theorem (Complex Analysis)},
  year = 2026,
  month = feb,
  journal = {Wikipedia},
  url = {https://en.wikipedia.org/w/index.php?title=Open_mapping_theorem_(complex_analysis)&oldid=1336386408},
  urldate = {2026-02-19},
  abstract = {In complex analysis, the open mapping theorem states that if                         U                 \textbraceleft\textbackslash displaystyle U\textbraceright{}     is a domain of the complex plane                                    C                          \textbraceleft\textbackslash displaystyle \textbackslash mathbb \textbraceleft C\textbraceright{} \textbraceright{}     and                         f         :         U         {$\rightarrow$}                    C                          \textbraceleft\textbackslash displaystyle f:U\textbackslash to \textbackslash mathbb \textbraceleft C\textbraceright{} \textbraceright{}     is a non-constant holomorphic function, then                         f                 \textbraceleft\textbackslash displaystyle f\textbraceright{}     is an open map (i.e. it sends open subsets of                         U                 \textbraceleft\textbackslash displaystyle U\textbraceright{}     to open subsets of                                    C                          \textbraceleft\textbackslash displaystyle \textbackslash mathbb \textbraceleft C\textbraceright{} \textbraceright{}    , and we have invariance of domain.). The open mapping theorem points to the sharp difference between holomorphy and real-differentiability. On the real line, for example, the differentiable function                         f         (         x         )         =                    x                        2                                     \textbraceleft\textbackslash displaystyle f(x)=x\textasciicircum\textbraceleft 2\textbraceright\textbraceright{}     is not an open map, as the image of the open interval                         (         -         1         ,         1         )                 \textbraceleft\textbackslash displaystyle (-1,1)\textbraceright{}     is the half-open interval                         [         0         ,         1         )                 \textbraceleft\textbackslash displaystyle [0,1)\textbraceright{}    .  The theorem for example implies that a non-constant holomorphic function cannot map an open disk onto a portion of any line embedded in the complex plane. Images of holomorphic functions can be of real dimension zero (if constant) or two (if non-constant) but never of dimension 1.},
  copyright = {Creative Commons Attribution-ShareAlike License},
  langid = {english},
  keywords = {explored},
  annotation = {Page Version ID: 1336386408}
}

