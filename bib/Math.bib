@misc{weissteinFiberBundle,
  type = {Text},
  title = {Fiber {{Bundle}}},
  author = {Weisstein, Eric W.},
  publisher = {Wolfram Research, Inc.},
  url = {https://mathworld.wolfram.com/FiberBundle.html},
  urldate = {2026-03-27},
