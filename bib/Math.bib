@article{agolVirtualHakenConjecture2013,
  title = {The Virtual {{Haken}} Conjecture (with an Appendix by {{Ian Agol}}, {{Daniel Groves}} and {{Jason Manning}})},
  author = {Agol, Ian},
  year = 2013,
  journal = {Documenta Mathematica},
  volume = {18},
  pages = {1045--1087},
  issn = {1431-0635, 1431-0643},
  doi = {10.4171/dm/421},
  url = {https://ems.press/doi/10.4171/dm/421},
  urldate = {2026-07-07},
  abstract = {We prove that cubulated hyperbolic groups are virtually special. The proof relies on results of Haglund and Wise which also imply that they are linear groups, and quasi-convex subgroups are separable. A consequence is that closed hyperbolic 3-manifolds have finite-sheeted Haken covers, which resolves the virtual Haken question of Waldhausen and Thurston's virtual fibering question. An appendix to this paper by Agol, Groves, and Manning proves a generalization of the main result of [1].}
}

@book{ahlforsComplexAnalysisIntroduction2013,
