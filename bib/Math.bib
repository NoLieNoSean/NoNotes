  url = {http://arxiv.org/abs/2012.15447},
  urldate = {2025-09-02},
  abstract = {We prove that the multi-Rees algebra R(I1 {$\oplus$} {$\cdot$} {$\cdot$} {$\cdot$} {$\oplus$} Ir) of a collection of strongly stable ideals I1, . . . , Ir is of fiber type. In particular, we provide a Gr\textasciidieresis obner basis for its defining ideal as a union of a Gr\textasciidieresis obner basis for its special fiber and binomial syzygies. We also study the Koszulness of R(I1 {$\oplus$} {$\cdot$} {$\cdot$} {$\cdot$} {$\oplus$} Ir) based on parameters associated to the collection. Furthermore, we establish a quadratic Gr\textasciidieresis obner basis of the defining ideal of R(I1 {$\oplus$} I2) where each of the strongly stable ideals has two quadric Borel generators. As a consequence, we conclude that this multi-Rees algebra is Koszul.},
