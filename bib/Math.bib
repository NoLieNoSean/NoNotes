@article{ForcingMathematics2026,
  title = {Forcing (Mathematics)},
  year = 2026,
  month = apr,
  journal = {Wikipedia},
  url = {https://en.wikipedia.org/w/index.php?title=Forcing_(mathematics)&oldid=1350078134},
  urldate = {2026-05-24},
  abstract = {In set theory, forcing is a technique for proving consistency and independence results. Intuitively, forcing can be thought of as a technique to expand the set theoretical universe                         V                 \textbraceleft\textbackslash displaystyle V\textbraceright{}     to a larger universe                         V         [         G         ]                 \textbraceleft\textbackslash displaystyle V[G]\textbraceright{}     by introducing a new "generic" object                         G                 \textbraceleft\textbackslash displaystyle G\textbraceright{}    . Forcing was first used by Paul Cohen in 1963, to prove the independence of the axiom of choice and the continuum hypothesis from Zermelo--Fraenkel set theory. It has been considerably reworked and simplified in the following years, and has since served as a powerful technique, both in set theory and in areas of mathematical logic such as computability theory. Descriptive set theory uses the notions of forcing from both computability theory and set theory. Forcing has also been used in model theory, but it is common in model theory to define genericity directly without mention of forcing.},
  copyright = {Creative Commons Attribution-ShareAlike License},
  langid = {english},
  annotation = {Page Version ID: 1350078134}
}

